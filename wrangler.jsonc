// wrangler.jsonc
{
	"name": "portfolio-astrojs",
	"compatibility_date": "2026-06-27",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
