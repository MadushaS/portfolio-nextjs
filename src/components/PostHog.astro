---
import { PUBLIC_POSTHOG_HOST, PUBLIC_POSTHOG_KEY } from "astro:env/client";

// PostHog Web SDK (official Astro integration pattern).
// - is:inline: Astro must not process/bundle this snippet
// - define:vars: safely inlines the public key/host at build time
// - cookieless_mode "on_reject": privacy-first — no cookies/localStorage and
//   no persistent distinct_id until the visitor accepts via <CookieConsent />.
//   Accepting calls posthog.opt_in_capturing(); rejecting keeps cookieless mode.
---

{
	PUBLIC_POSTHOG_KEY && (
		<script
			is:inline
			define:vars={{ posthogKey: PUBLIC_POSTHOG_KEY, posthogHost: PUBLIC_POSTHOG_HOST }}
		>
			if (!window.__posthog_initialized) {
				window.__posthog_initialized = true;
				!(function (t, e) {
					var o, n, p, r;
					e.__SV ||
						((window.posthog = e),
						(e._i = []),
						(e.init = function (i, s, a) {
							function g(t, e) {
								var o = e.split(".");
								2 == o.length && ((t = t[o[0]]), (e = o[1])),
									(t[e] = function () {
										t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
									});
							}
							((p = t.createElement("script")).type = "text/javascript"),
								(p.crossOrigin = "anonymous"),
								(p.async = !0),
								(p.src = s.api_host.replace(".i.posthog.com", "-assets.i.posthog.com") + "/static/array.js"),
								(r = t.getElementsByTagName("script")[0]).parentNode.insertBefore(p, r);
							var u = e;
							for (
								void 0 !== a ? (u = e[a] = []) : (a = "posthog"),
									u.people = u.people || [],
									u.toString = function (t) {
										var e = "posthog";
										return "posthog" !== a && (e += "." + a), t || (e += " (stub)"), e;
									},
									u.people.toString = function () {
										return u.toString(1) + ".people (stub)";
									},
									o =
										"init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep".split(
											" "
										),
									n = 0;
								n < o.length;
								n++
							)
								g(u, o[n]);
							e._i.push([i, s, a]);
						}),
						(e.__SV = 1));
				})(document, window.posthog || []);

				window.posthog.init(posthogKey, {
					api_host: posthogHost,
					defaults: "2026-05-30",
					person_profiles: "identified_only",
					capture_pageview: true,
					capture_pageleave: true,
					// GDPR/privacy-friendly default: run cookieless until consent.
					// No events with persistent IDs are stored before a decision;
					// rejecting keeps cookieless measurement, accepting opts in fully.
					cookieless_mode: "on_reject",
				});

				// Re-apply a previously stored consent decision on every load.
				const consent = localStorage.getItem("cookie-consent");
				if (consent === "accepted") {
					window.posthog.opt_in_capturing();
				} else if (consent === "rejected") {
					window.posthog.opt_out_capturing();
				}
			}
		</script>
	)
}
