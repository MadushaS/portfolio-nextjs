# --- Client (public) ---
PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id

# --- Server (secret — never exposed to the browser) ---
# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Inbox that receives contact form emails
CONTACT_EMAIL=work@madusha.dev

# Telegram bot notifications (optional)
# 1. Create a bot via @BotFather -> token
# 2. Message the bot once, then read chat id from:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
